{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedStackWithItsRole",
      "Effect": "Allow",
      "Action": "cloudformation:CreateStack",
      "Resource": "arn:aws:cloudformation:REGION:ACCOUNT_ID:stack/d618-*/*",
      "Condition": {
        "ArnEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::ACCOUNT_ID:role/d618-stack"
        },
        "StringEquals": {
          "aws:RequestTag/cloud.campaign": "D618"
        }
      }
    },
    {
      "Sid": "TagStackAtCreation",
      "Effect": "Allow",
      "Action": "cloudformation:TagResource",
      "Resource": "arn:aws:cloudformation:REGION:ACCOUNT_ID:stack/d618-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cloud.campaign": "D618"
        }
      }
    },
    {
      "Sid": "ReadAndDeleteEvenAfterBudgetAction",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DeleteStack"
      ],
      "Resource": "arn:aws:cloudformation:REGION:ACCOUNT_ID:stack/d618-*/*"
    },
    {
      "Sid": "PassOnlyStackRoleToCloudFormation",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/d618-stack",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "StopExperimentWorker",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/cloud.campaign": "D618"
        }
      }
    },
    {
      "Sid": "MachineChecks",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeImages",
        "ec2:DescribeKeyPairs"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION"
        }
      }
    },
    {
      "Sid": "ReadBudget",
      "Effect": "Allow",
      "Action": "budgets:ViewBudget",
      "Resource": "arn:aws:budgets::ACCOUNT_ID:budget/D618"
    },
    {
      "Sid": "ReadBudgetAction",
      "Effect": "Allow",
      "Action": "budgets:DescribeBudgetAction",
      "Resource": "arn:aws:budgets::ACCOUNT_ID:budget/D618/action/*"
    },
    {
      "Sid": "InspectRolesAndSimulate",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:SimulatePrincipalPolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/d618-launcher",
        "arn:aws:iam::ACCOUNT_ID:role/d618-stack",
        "arn:aws:iam::ACCOUNT_ID:role/d618-scheduler",
        "arn:aws:iam::ACCOUNT_ID:role/d618-budget"
      ]
    },
    {
      "Sid": "OwnerQuotaAndSpendChecks",
      "Effect": "Allow",
      "Action": [
        "servicequotas:GetServiceQuota",
        "ce:GetCostAndUsage"
      ],
      "Resource": "*"
    }
  ]
}
