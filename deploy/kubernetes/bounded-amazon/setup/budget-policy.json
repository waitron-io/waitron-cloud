{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
    "Resource": "arn:aws:iam::ACCOUNT_ID:role/d618-launcher",
    "Condition": {"ArnEquals": {"iam:PolicyARN": "arn:aws:iam::ACCOUNT_ID:policy/d618-deny-launch"}}
  }]
}
